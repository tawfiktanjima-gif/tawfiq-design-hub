NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never expose (NEXT_PUBLIC_ prefix দেবেন না)
DOWNLOAD_HASH_SALT=          # random long string (openssl rand -hex 32)
NEXT_PUBLIC_SITE_URL=        # https://your-domain.com (sitemap/SEO)
DOWNLOAD_RATE_MAX=20         # optional: প্রতি IP-তে সর্বোচ্চ ডাউনলোড অনুরোধ
DOWNLOAD_RATE_WINDOW_MIN=10  # optional: উপরের সীমার সময় (মিনিট)
